# App
NODE_ENV=development
PORT=8080

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-each-env
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-in-each-env
REFRESH_EXPIRES_IN=30d

# DB (local)
DATABASE_URL=postgresql://user:pass@localhost:5432/appdb?sslmode=disable

# (opcional) Staging/Prod via secrets no Fly/GitHub:
# FLY will inject DATABASE_URL, JWT_SECRET, REFRESH_SECRET como secrets
